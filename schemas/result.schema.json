{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Building Plan Measurement Extraction Result",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "status",
    "source_file",
    "input_type",
    "image_width_px",
    "image_height_px",
    "primary_unit",
    "scale",
    "overall_dimensions",
    "spaces",
    "measurements",
    "warnings",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "plan_id": { "type": "string" },
    "status": { "enum": ["success", "partial", "failed"] },
    "source_file": { "type": "string" },
    "input_type": { "type": "string" },
    "image_width_px": { "type": "integer" },
    "image_height_px": { "type": "integer" },
    "primary_unit": { "type": "string" },
    "scale": {
      "type": "object",
      "required": ["detected"],
      "properties": {
        "detected": { "type": "boolean" },
        "raw_text": { "type": ["string", "null"] },
        "ratio": { "type": ["number", "null"] },
        "confidence": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "overall_dimensions": {
      "type": "object",
      "properties": {
        "width_mm": { "type": ["number", "null"] },
        "height_mm": { "type": ["number", "null"] },
        "width_source": {
          "type": ["object", "null"],
          "required": ["raw_text", "bounding_box", "confidence"],
          "properties": {
            "raw_text": { "type": "string" },
            "bounding_box": {
              "type": "object",
              "required": ["x_min", "y_min", "x_max", "y_max"],
              "properties": {
                "x_min": { "type": "number" },
                "y_min": { "type": "number" },
                "x_max": { "type": "number" },
                "y_max": { "type": "number" }
              },
              "additionalProperties": false
            },
            "confidence": {
              "type": "object",
              "required": ["ocr", "association", "overall"],
              "properties": {
                "ocr": { "type": "number" },
                "association": { "type": "number" },
                "overall": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "height_source": {
          "type": ["object", "null"],
          "required": ["raw_text", "bounding_box", "confidence"],
          "properties": {
            "raw_text": { "type": "string" },
            "bounding_box": {
              "type": "object",
              "required": ["x_min", "y_min", "x_max", "y_max"],
              "properties": {
                "x_min": { "type": "number" },
                "y_min": { "type": "number" },
                "x_max": { "type": "number" },
                "y_max": { "type": "number" }
              },
              "additionalProperties": false
            },
            "confidence": {
              "type": "object",
              "required": ["ocr", "association", "overall"],
              "properties": {
                "ocr": { "type": "number" },
                "association": { "type": "number" },
                "overall": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["space_id", "name", "source", "dimensions"],
        "properties": {
          "space_id": { "type": "string" },
          "name": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["raw_text", "bounding_box"],
            "properties": {
              "raw_text": { "type": "string" },
              "bounding_box": {
                "type": "object",
                "required": ["x_min", "y_min", "x_max", "y_max"],
                "properties": {
                  "x_min": { "type": "number" },
                  "y_min": { "type": "number" },
                  "x_max": { "type": "number" },
                  "y_max": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "dimensions": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "measurement_id",
          "type",
          "raw_text",
          "value",
          "secondary_value",
          "unit",
          "associated_element",
          "source",
          "component_sources",
          "confidence",
          "ambiguity",
          "review_required"
        ],
        "properties": {
          "measurement_id": { "type": "string" },
          "type": { "type": "string" },
          "raw_text": { "type": "string" },
          "value": { "type": ["number", "null"] },
          "secondary_value": { "type": ["number", "null"] },
          "unit": { "type": ["string", "null"] },
          "associated_element": {
            "type": "object",
            "required": ["element_id", "name"],
            "properties": {
              "element_id": { "type": ["string", "null"] },
              "name": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "required": ["raw_text", "bounding_box"],
            "properties": {
              "raw_text": { "type": "string" },
              "bounding_box": {
                "type": "object",
                "required": ["x_min", "y_min", "x_max", "y_max"],
                "properties": {
                  "x_min": { "type": "number" },
                  "y_min": { "type": "number" },
                  "x_max": { "type": "number" },
                  "y_max": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "component_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["raw_text", "bounding_box", "ocr"],
              "properties": {
                "raw_text": { "type": "string" },
                "bounding_box": {
                  "type": "object",
                  "required": ["x_min", "y_min", "x_max", "y_max"],
                  "properties": {
                    "x_min": { "type": "number" },
                    "y_min": { "type": "number" },
                    "x_max": { "type": "number" },
                    "y_max": { "type": "number" }
                  },
                  "additionalProperties": false
                },
                "ocr": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "object",
            "required": ["ocr", "association", "overall"],
            "properties": {
              "ocr": { "type": "number" },
              "association": { "type": "number" },
              "overall": { "type": "number" }
            }
          },
          "ambiguity": { "type": ["string", "null"] },
          "review_required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "measurement_id": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "ocr_detections",
        "spaces_detected",
        "measurements_detected",
        "review_required",
        "high_confidence",
        "medium_confidence",
        "low_confidence"
      ],
      "properties": {
        "ocr_detections": { "type": "integer" },
        "spaces_detected": { "type": "integer" },
        "measurements_detected": { "type": "integer" },
        "review_required": { "type": "integer" },
        "high_confidence": { "type": "integer" },
        "medium_confidence": { "type": "integer" },
        "low_confidence": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": ["object", "null"],
      "properties": {
        "expected": { "type": "integer" },
        "matched": { "type": "integer" },
        "incorrect_value": { "type": "integer" },
        "incorrect_unit": { "type": "integer" },
        "missed": { "type": "integer" },
        "unexpected": { "type": "integer" },
        "duplicate_count": { "type": "integer" },
        "precision": { "type": "number" },
        "recall": { "type": "number" },
        "f1": { "type": "number" },
        "accuracy": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}